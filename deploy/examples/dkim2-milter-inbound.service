[Unit]
Description=DKIM2 Milter Daemon (inbound: verify + MI)
After=network.target
Documentation=https://github.com/dkim2wg/interop/blob/master/docs/dkim2-postfix-list-host-guide.md
Before=postfix.service

[Service]
Type=simple
User=dkim2
Group=postfix
ExecStartPre=/bin/mkdir -p /var/spool/postfix/var/run
ExecStartPre=/bin/mkdir -p /var/spool/dkim2/snapshots
ExecStart=/usr/local/bin/dkim2-milter \
    --mode inbound \
    --socket unix:/var/spool/postfix/var/run/dkim2-milter-in.sock \
    --snapshot-dir /var/spool/dkim2/snapshots
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/spool/postfix/var/run /var/spool/dkim2/snapshots
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
