[Unit]
Description=DKIM2 Milter Daemon (verify and sign on one socket)
After=network.target
Documentation=https://github.com/dkim2wg/interop/blob/master/docs/dkim2-postfix-list-host-guide.md
Before=postfix.service

[Service]
Type=simple
User=dkim2
Group=postfix
# "+" runs these with full privileges, outside the sandbox below, so the
# directories exist with the right owner before the milter starts.
ExecStartPre=+/usr/bin/install -d -m 750 -o dkim2 -g postfix /var/spool/postfix/var/run
ExecStartPre=+/usr/bin/install -d -m 750 -o dkim2 -g postfix /var/spool/dkim2/snapshots
ExecStart=/usr/local/bin/dkim2-milter \
    --socket unix:/var/spool/postfix/var/run/dkim2-milter.sock \
    --keydir /etc/dkim2/keys \
    --snapshot-dir /var/spool/dkim2/snapshots
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/spool/postfix/var/run /var/spool/dkim2/snapshots
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
