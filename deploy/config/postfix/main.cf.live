alias_database = hash:/etc/aliases, hash:/etc/sympa/sympa/aliases
alias_maps = hash:/etc/aliases, hash:/etc/sympa/sympa/aliases
append_dot_mydomain = no
biff = no
compatibility_level = 3.6
cyrus_sasl_config_path = /etc/postfix/sasl
default_process_limit = 20
disable_mime_output_conversion = yes
dkim2-delayedbounce_destination_recipient_limit = 1
dkim2-reflect_destination_recipient_limit = 1
inet_interfaces = all
inet_protocols = all
internal_mail_filter_classes = bounce
local_recipient_maps = proxy:unix:passwd.byname $alias_maps regexp:/var/lib/mailman3/data/postfix_lmtp hash:/etc/postfix/dkim2-transport hash:/etc/postfix/dkim2-delayedbounce
mailbox_size_limit = 0
milter_default_action = accept
milter_protocol = 6
mydestination = dkim2.com, test1.dkim2.com, test2.dkim2.com, test3.dkim2.com, test4.dkim2.com, test5.dkim2.com, sympa.dkim2.com, mailman.dkim2.com, localhost
mydomain = dkim2.com
myhostname = mail.dkim2.com
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128
myorigin = $mydomain
non_smtpd_milters = unix:var/run/dkim2-milter-out.sock,inet:localhost:8891
recipient_delimiter = +
relayhost =
smtp_tls_CApath = /etc/ssl/certs
smtp_tls_security_level = may
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache
smtpd_banner = $myhostname ESMTP $mail_name (Ubuntu)
smtpd_milters = unix:var/run/dkim2-milter-in.sock, inet:localhost:8891
smtpd_relay_restrictions = permit_mynetworks permit_sasl_authenticated defer_unauth_destination
smtpd_tls_cert_file = /etc/letsencrypt/live/mail.dkim2.com/fullchain.pem
smtpd_tls_key_file = /etc/letsencrypt/live/mail.dkim2.com/privkey.pem
smtpd_tls_security_level = may
transport_maps = regexp:/var/lib/mailman3/data/postfix_lmtp hash:/etc/postfix/dkim2-transport hash:/etc/postfix/dkim2-delayedbounce
