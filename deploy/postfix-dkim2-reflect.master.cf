# DKIM2 reflector pipe(8) transport. Append this service to /etc/postfix/master.cf.
#
# WHY A PIPE TRANSPORT, NOT A local(8) "|command" ALIAS:
# local(8) prepends a Delivered-To: header to the message before running the
# alias command. Delivered-To is NOT an IANA trace header (only Received and
# Return-Path are; Delivered-To is only provisionally registered, RFC 9228), so
# DKIM2 §5.2 does not exclude it from the header-field hash. The reflector would
# therefore hash that Delivered-To into its Message-Instance — but the header is
# renamed (X-Remote-Delivered-To) or dropped before the reply is delivered, so
# the m= header hash could never be verified by the recipient. pipe(8) does not
# add Delivered-To. See docs/dkim2-implementer-guide.md ("Postfix Delivered-To").
#
# pipe(8) also does not export $SENDER the way local(8) does, so the envelope
# sender is passed as the ${sender} argv macro (the wrapper also still honours
# $ENV{SENDER} for legacy/manual use). ${user} is the recipient localpart
# (e.g. "reflector-both"); the wrapper maps it to the reflect mode.
#
# Recipients are routed here by transport_maps and accepted at RCPT via
# local_recipient_maps — both pointing at hash:/etc/postfix/dkim2-transport.
# Set "dkim2-reflect_destination_recipient_limit = 1" in main.cf so each
# recipient gets its own invocation (keeps ${user} unambiguous).
dkim2-reflect unix  -       n       n       -       -       pipe
  flags=q user=nobody:nogroup
  argv=/usr/local/bin/dkim2-reflect ${user} ${sender}

# dkim2-bounces@dkim2.com: envelope MAIL FROM on reflector-sent mail (see
# dkim2-reflector.pl). Verifies + undoes + relays DKIM2-DSN bounces of
# reflected messages back to the reconstructed originator; anything it
# cannot authenticate falls through to the reflector-bounces mbox instead
# of being relayed. Same pipe(8) rationale as dkim2-reflect above (no
# Delivered-To header, ${user}/${sender} macros available). The handler
# itself does not need ${user}/${sender} (it reads the DKIM2-DSN's own
# rt=/mf= from the message body), but they are passed for parity/logging.
dkim2-bounces unix  -       n       n       -       -       pipe
  flags=q user=nobody:nogroup
  argv=/usr/local/bin/dkim2-bounces ${user} ${sender}
