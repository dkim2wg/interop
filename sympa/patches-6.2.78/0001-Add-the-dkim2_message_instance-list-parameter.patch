From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bron Gondwana <brong@fastmailteam.com>
Date: Thu, 8 Oct 2026 14:07:53 -0400
Subject: [PATCH 1/3] Add the dkim2_message_instance list parameter

A list, robot or site parameter, on/off, default off, in the dkim group.
It switches on the DKIM2 Message-Instance support added next: with it
off a list behaves exactly as before, so a site can install the change
and enable it one list at a time.

t/DKIM2.t starts here with a check of the parameter's definition and is
added to check_SCRIPTS.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Makefile.am                    |  1 +
 src/lib/Sympa/Config/Schema.pm | 13 +++++++++++++
 t/DKIM2.t                      | 15 +++++++++++++++
 3 files changed, 29 insertions(+)
 create mode 100644 t/DKIM2.t

diff --git a/Makefile.am b/Makefile.am
index 87dc1a471..6c4aa2819 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -27,6 +27,7 @@ check_SCRIPTS = \
 	t/01_Conf.t \
 	t/CLI_getoptions.t \
 	t/Config_XML.t \
+	t/DKIM2.t \
 	t/DataSource_LDAP2.t \
 	t/Database_LDAP.t \
 	t/Database_SQLite.t \
diff --git a/src/lib/Sympa/Config/Schema.pm b/src/lib/Sympa/Config/Schema.pm
index 4937ff3f4..fc99d91a1 100644
--- a/src/lib/Sympa/Config/Schema.pm
+++ b/src/lib/Sympa/Config/Schema.pm
@@ -4902,6 +4902,19 @@ our %pinfo = (
         not_before => '6.2.74',
     },
 
+    dkim2_message_instance => {
+        context    => [qw(list domain site)],
+        order      => 70.09,
+        group      => 'dkim',
+        gettext_id => 'Add DKIM2 Message-Instance header fields',
+        gettext_comment =>
+            'If set to "on", Sympa records what it changed in each message in a DKIM2 Message-Instance header field (draft-ietf-dkim-dkim2-spec), wraps decorated messages in a MIME container so the original body is carried unchanged, and marks the body unrecoverable when it rewrites it. Requires the Mail::DKIM2 Perl module; the DKIM2-Signature itself is added by the MTA.',
+        format     => ['on', 'off'],
+        occurrence => '1',
+        default    => 'off',
+        not_before => '6.2.78',
+    },
+
     ### Optional features
 
     ### List address verification
diff --git a/t/DKIM2.t b/t/DKIM2.t
new file mode 100644
index 000000000..f042f8ece
--- /dev/null
+++ b/t/DKIM2.t
@@ -0,0 +1,15 @@
+# -*- indent-tabs-mode: nil; -*-
+# DKIM2 Message-Instance support.
+use strict; use warnings;
+use Test::More;
+use Sympa::Config::Schema;
+
+subtest 'switch parameter' => sub {
+    my %p = %{ $Sympa::Config::Schema::pinfo{dkim2_message_instance} || {} };
+    ok %p, 'defined';
+    is_deeply $p{format}, ['on', 'off'], 'on/off';
+    is $p{default}, 'off', 'default off';
+    is_deeply $p{context}, [qw(list domain site)], 'list/domain/site';
+};
+
+done_testing;
