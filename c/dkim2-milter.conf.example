# dkim2-milter configuration
# Copy to dkim2-milter.conf and edit before use.

# Milter socket (inet or unix)
socket=inet:8891@localhost

# Mode: s=signer, v=verifier, r=reviser
mode=s

# Signing domain (required for s/r modes)
domain=example.com

# DKIM2 selector (required for s/r modes)
selector=default

# Path to PEM-encoded private key (required for s/r modes)
privkey=/etc/dkim2/private.pem

# Signing algorithm: ed25519-sha256 (default) or rsa-sha256
alg=ed25519-sha256

# From domains above domain= that domain= may sign for (draft -09 §12.4,
# a d= below the From domain). Repeat the line for each; with none, a From
# in a parent domain is refused. The signer makes no DNS lookup for this.
# parent_from=example.org

# Authentication-Results authservid (verifier mode; defaults to "localhost")
# authservid=mail.example.com

# Signer gate (modes s/r): a message already carrying a DKIM2 chain is verified
# before it is extended, and delivered UNSIGNED (logged) if the chain does not
# verify. A null body Recipe on a Message-Instance no DKIM2-Signature covers yet
# (this host's own, e.g. a list manager's) is signed over; a null an upstream
# domain already signed fails the check and is refused. Keys for the check
# come from DNS. allow_null_body_recipe is deprecated (draft -09) and does
# nothing; setting it to 1 only logs a warning.
