 5 files changed, 94 insertions(+), 1 deletion(-)

diff --git a/src/mailman/config/schema.cfg b/src/mailman/config/schema.cfg
index fb59b3df8..75fe0f224 100644
--- a/src/mailman/config/schema.cfg
+++ b/src/mailman/config/schema.cfg
@@ -90,6 +90,16 @@ html_to_plain_text_command: /usr/bin/lynx -dump $filename
 # the message?
 filter_report: no
 
+# How should a list's header and footer be added to a single-part text/plain
+# message?  With 'yes', they are joined to the text itself, which is decoded
+# and re-encoded (a utf-8 body, say, usually comes out base64), so every line
+# of the body can change.  With 'no', the message is wrapped in a
+# multipart/mixed with the header and footer as their own text/plain parts,
+# as is already done for other content types, and the body is left as it
+# arrived.  That keeps the sender's body intact for mechanisms that record
+# or verify what a list changed, such as DKIM2 Message-Instance Recipes.
+decorate_plain_text_in_place: yes
+
 # Specify what characters are allowed in list names.  Characters outside of
 # the class [-_.+=!$*{}~0-9a-z] matched case insensitively are never allowed,
 # but this specifies a subset as the only allowable characters.  This must be
diff --git a/src/mailman/handlers/decorate.py b/src/mailman/handlers/decorate.py
index bc95760ba..9b540125e 100644
--- a/src/mailman/handlers/decorate.py
+++ b/src/mailman/handlers/decorate.py
@@ -23,7 +23,9 @@ import logging
 
 from email.mime.text import MIMEText
 from email.utils import formataddr
+from lazr.config import as_boolean
 from mailman.archiving.mailarchive import MailArchive
+from mailman.config import config
 from mailman.core.i18n import _
 from mailman.interfaces.handler import IHandler
 from mailman.interfaces.mailinglist import IListArchiverSet
@@ -113,7 +115,8 @@ def process(mlist, msg, msgdata):
     # BAW: If the charsets don't match, should we add the header and footer by
     # MIME multipart chroming the message?
     wrap = True
-    if not msg.is_multipart() and msgtype == 'text/plain':
+    if (not msg.is_multipart() and msgtype == 'text/plain'
+            and as_boolean(config.mailman.decorate_plain_text_in_place)):
         # Save the RFC-3676 format parameters.
         format_param = msg.get_param('format')
         delsp = msg.get_param('delsp')
diff --git a/src/mailman/handlers/tests/test_decorate.py b/src/mailman/handlers/tests/test_decorate.py
index 90134329c..116cf7259 100644
--- a/src/mailman/handlers/tests/test_decorate.py
+++ b/src/mailman/handlers/tests/test_decorate.py
@@ -383,6 +383,84 @@ Footer:
                       self._msg.as_string())
 
 
+class TestDecoratePlainTextInPlace(unittest.TestCase):
+    """Test the decorate_plain_text_in_place setting."""
+
+    layer = ConfigLayer
+
+    def setUp(self):
+        self._mlist = create_list('ant@example.com')
+        self._mlist.preferred_language = 'en'
+        # A body in a charset and encoding that decorating in place changes.
+        self._msg = mfs("""\
+To: ant@example.com
+From: aperson@example.com
+Message-ID: <alpha>
+MIME-Version: 1.0
+Content-Type: text/plain; charset="utf-8"; format="flowed"
+Content-Transfer-Encoding: quoted-printable
+
+Caf=C3=A9 au lait.
+""")
+        temporary_dir = TemporaryDirectory()
+        self.addCleanup(temporary_dir.cleanup)
+        config.push('templates', """\
+        [paths.testing]
+        template_dir: {}
+        """.format(temporary_dir.name))
+        self.addCleanup(config.pop, 'templates')
+        site_dir = os.path.join(config.TEMPLATE_DIR, 'site', 'en')
+        os.makedirs(site_dir)
+        with open(os.path.join(site_dir, 'myfooter.txt'), 'w',
+                  encoding='utf-8') as fp:
+            print('The footer', file=fp)
+        getUtility(ITemplateManager).set(
+            'list:member:regular:footer', None, 'mailman:///myfooter.txt')
+
+    def test_in_place_by_default(self):
+        decorate.process(self._mlist, self._msg, {})
+        self.assertFalse(self._msg.is_multipart())
+        self.assertEqual(self._msg['content-transfer-encoding'], 'base64')
+        self.assertEqual(
+            self._msg.get_payload(decode=True).decode('utf-8'),
+            'Caf\xe9 au lait.\nThe footer\n')
+
+    def test_wrapped_when_not_in_place(self):
+        with configuration('mailman', decorate_plain_text_in_place='no'):
+            decorate.process(self._mlist, self._msg, {})
+        self.assertEqual(self._msg.get_content_type(), 'multipart/mixed')
+        body, footer = self._msg.get_payload()
+        # The post is untouched: same fields, same encoded octets.
+        self.assertEqual(body.items(), [
+            ('Content-Type', 'text/plain; charset="utf-8"; format="flowed"'),
+            ('Content-Transfer-Encoding', 'quoted-printable'),
+            ])
+        self.assertEqual(body.get_payload(), 'Caf=C3=A9 au lait.\n')
+        self.assertEqual(footer.get_payload(), 'The footer\n')
+        self.assertEqual(footer['content-disposition'], 'inline')
+
+    def test_multipart_mixed_unaffected(self):
+        msg = mfs("""\
+To: ant@example.com
+From: aperson@example.com
+Message-ID: <alpha>
+Content-Type: multipart/mixed; boundary="aaaaaa"
+
+--aaaaaa
+Content-Type: text/plain;
+
+This is a test message.
+--aaaaaa--
+""")
+        with configuration('mailman', decorate_plain_text_in_place='no'):
+            decorate.process(self._mlist, msg, {})
+        # The footer is appended as a part, as it always was.
+        parts = msg.get_payload()
+        self.assertEqual(len(parts), 2)
+        self.assertEqual(parts[0].get_payload(), 'This is a test message.')
+        self.assertEqual(parts[1].get_payload(), 'The footer\n')
+
+
 class TestBrokenPermalink(unittest.TestCase):
     layer = ConfigLayer
 
