+        self.assertTrue(info.endswith(';'), info)
+        self.assertRegex(info, r'^draft=\S+; repo=\S+; date=\d{4}-\d\d-\d\d; '
+                               r'sw=mailman; action=mi-m=1; hc=\d+; hn=\S+; '
