+        self.assertIn('h', recipe)
+        self.assertIsNotNone(recipe['h'])
+        v, err = verify_message_instance(msg)
+        self.assertEqual(v, 1, err)
+        # The kitten is not in the Recipe.
+        self.assertNotIn('AAAA', msg['message-instance'])
