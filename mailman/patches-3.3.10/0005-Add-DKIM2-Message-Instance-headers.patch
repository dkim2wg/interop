+        # current instances: [2, 3], not [2, 2] twice.
+        recipe = compute_header_recipe(
+            [('Comments', 'same'), ('Comments', 'same'), ('Comments', 'x')],
+            [('Comments', 'same'), ('Comments', 'same')])
