 src/mailman/docs/NEWS.rst                   |  4 ++
 src/mailman/handlers/decorate.py            |  5 +-
 src/mailman/handlers/tests/test_decorate.py | 78 +++++++++++++++++++++
 src/mailman/rest/docs/systemconf.rst        |  1 +
 src/mailman/rest/tests/test_systemconf.py   |  1 +
 6 files changed, 94 insertions(+), 1 deletion(-)

diff --git a/src/mailman/config/schema.cfg b/src/mailman/config/schema.cfg
index f38e0fe5e..e2909e8a9 100644
--- a/src/mailman/config/schema.cfg
+++ b/src/mailman/config/schema.cfg
@@ -101,6 +101,12 @@ html_to_plain_text_command: /usr/bin/lynx -dump $filename
 # the message?
 filter_report: no
 
+# Should a list's header and footer be added to a single-part text/plain
+# message by joining them to its text, which re-encodes the body?  If 'no',
+# the message is wrapped in a multipart/mixed, as other content types are, and
+# the body is left as it arrived.
+decorate_plain_text_in_place: yes
+
 # Specify what characters are allowed in list names.  Characters outside of
 # the class [-_.+=!$*{}~0-9a-z] matched case insensitively are never allowed,
 # but this specifies a subset as the only allowable characters.  This must be
