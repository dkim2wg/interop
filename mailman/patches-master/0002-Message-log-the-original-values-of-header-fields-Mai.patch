From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bron Gondwana <brong@fastmailteam.com>
Date: Fri, 13 Nov 2026 22:23:00 -0800
Subject: [PATCH 2/4] Message: log the original values of header fields Mailman
 changes

A DKIM2 Message-Instance Recipe has to rebuild the header fields a post
arrived with.  Rather than keep a copy of the message as received,
Message can keep a log: once started, the first change to a header field
name records every value that name had before it.

compat32's email.message.Message edits its header list directly in six
methods, and every other header change goes through them, so those six
are overridden.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/mailman/email/message.py            |  56 ++++++++++
 src/mailman/email/tests/test_message.py | 139 ++++++++++++++++++++++++
 2 files changed, 195 insertions(+)

diff --git a/src/mailman/email/message.py b/src/mailman/email/message.py
index 34f83626a..e8c4df27c 100644
--- a/src/mailman/email/message.py
+++ b/src/mailman/email/message.py
@@ -47,6 +47,62 @@ class Message(email.message.Message):
     def __setstate__(self, values):
         self.__dict__ = values
 
+    # Once started, the header log maps each header field name (lower case)
+    # Mailman changes to the values it had before the first change ([] when
+    # it was absent).  The six methods below are the only ones that edit the
+    # header list directly; every other header change goes through them.
+
+    def start_header_log(self):
+        """Start logging header changes; a running log is kept as it is."""
+        if self.__dict__.get('_header_log') is None:
+            self._header_log = {}
+
+    def stop_header_log(self):
+        """Stop logging header changes and discard the log."""
+        self.__dict__.pop('_header_log', None)
+
+    @property
+    def header_log(self):
+        """The header log, or None when it has not been started."""
+        return self.__dict__.get('_header_log')
+
+    def _log_header(self, name):
+        log = self.__dict__.get('_header_log')
+        if log is None:
+            return
+        name = name.lower()
+        if name not in log:
+            log[name] = [value for key, value in self.raw_items()
+                         if key.lower() == name]
+
+    def prepend_header(self, name, value):
+        """Add a header field at the top, without logging it."""
+        self._headers.insert(0, (name, value))
+
+    def __setitem__(self, name, val):
+        self._log_header(name)
+        super().__setitem__(name, val)
+
+    def __delitem__(self, name):
+        self._log_header(name)
+        super().__delitem__(name)
+
+    def add_header(self, _name, _value, **_params):
+        self._log_header(_name)
+        super().add_header(_name, _value, **_params)
+
+    def replace_header(self, _name, _value):
+        self._log_header(_name)
+        super().replace_header(_name, _value)
+
+    def set_boundary(self, boundary):
+        self._log_header('content-type')
+        super().set_boundary(boundary)
+
+    def set_raw(self, name, value):
+        self._log_header(name)
+        super().set_raw(name, value)
+
     def as_string(self):
         # Work around for https://bugs.python.org/issue27321 and
         # https://bugs.python.org/issue32330.
diff --git a/src/mailman/email/tests/test_message.py b/src/mailman/email/tests/test_message.py
index 674a8dcdd..3cececed5 100644
--- a/src/mailman/email/tests/test_message.py
+++ b/src/mailman/email/tests/test_message.py
@@ -17,6 +17,8 @@
 
 """Test the message API."""
 
+import copy
+import pickle
 import unittest
 
 from email import message_from_binary_file
@@ -229,3 +231,140 @@ Message with \u201cNon-ascii\u201d.
             fp.seek(0)
             text = fp.read().decode('ascii', 'replace')
         self.assertEqual(msg.as_string(), text)
+
+
+class TestHeaderLog(unittest.TestCase):
+    """Test the log of original header field values."""
+
+    layer = ConfigLayer
+
+    RAW = """\
+From: anne@example.com
+To: ant@example.com
+Cc: a@example.com
+Cc: b@example.com
+Subject: hello
+MIME-Version: 1.0
+Content-Type: text/plain; charset="us-ascii"
+Content-Transfer-Encoding: 7bit
+
+Hello.
+"""
+
+    def _msg(self):
+        msg = mfs(self.RAW)
+        msg.start_header_log()
+        return msg
+
+    def test_parser_does_not_log(self):
+        msg = mfs(self.RAW)
+        self.assertIsNone(msg.header_log)
+
+    def test_not_started_records_nothing(self):
+        msg = mfs(self.RAW)
+        msg['Reply-To'] = 'list@example.com'
+        self.assertIsNone(msg.header_log)
+
+    def test_setitem_logs_absent(self):
+        msg = self._msg()
+        msg['Reply-To'] = 'list@example.com'
+        self.assertEqual(msg.header_log, {'reply-to': []})
+
+    def test_setitem_logs_existing(self):
+        msg = self._msg()
+        msg['Cc'] = 'c@example.com'
+        self.assertEqual(
+            msg.header_log, {'cc': ['a@example.com', 'b@example.com']})
+
+    def test_delitem_logs_all_values(self):
+        msg = self._msg()
+        del msg['cc']
+        self.assertEqual(
+            msg.header_log, {'cc': ['a@example.com', 'b@example.com']})
+
+    def test_first_touch_only(self):
+        msg = self._msg()
+        msg.replace_header('Subject', 'x')
+        msg.replace_header('Subject', 'y')
+        del msg['subject']
+        self.assertEqual(msg.header_log, {'subject': ['hello']})
+
+    def test_add_header(self):
+        msg = self._msg()
+        msg.add_header('Content-Disposition', 'inline')
+        self.assertEqual(msg.header_log, {'content-disposition': []})
+
+    def test_set_raw(self):
+        msg = self._msg()
+        msg.set_raw('List-Id', '<ant.example.com>')
+        self.assertEqual(msg.header_log, {'list-id': []})
+
+    def test_set_param_logs_content_type(self):
+        msg = self._msg()
+        msg.set_param('format', 'flowed')
+        self.assertEqual(msg.header_log,
+                         {'content-type': ['text/plain; charset="us-ascii"']})
+
+    def test_set_boundary_logs_content_type(self):
+        msg = mfs("""\
+From: anne@example.com
+Content-Type: multipart/mixed; boundary="aaa"
+
+--aaa
+
+x
+--aaa--
+""")
+        msg.start_header_log()
+        msg.set_boundary('bbb')
+        self.assertEqual(msg.header_log,
+                         {'content-type': ['multipart/mixed; boundary="aaa"']})
+
+    def test_set_payload_charset_logs(self):
+        msg = mfs("""\
+From: anne@example.com
+Subject: hi
+
+Hello.
+""")
+        msg.start_header_log()
+        msg.set_payload('caf\xe9', 'utf-8')
+        # set_charset adds all three, through add_header.
+        self.assertEqual(msg.header_log, {
+            'mime-version': [], 'content-type': [],
+            'content-transfer-encoding': []})
+
+    def test_start_is_idempotent(self):
+        msg = self._msg()
+        msg['Subject'] = 'changed'
+        msg.start_header_log()
+        self.assertEqual(msg.header_log, {'subject': ['hello']})
+
+    def test_pickle_and_deepcopy_carry_log(self):
+        msg = self._msg()
+        del msg['subject']
+        for other in (pickle.loads(pickle.dumps(msg)), copy.deepcopy(msg)):
+            self.assertEqual(other.header_log, {'subject': ['hello']})
+            other['To'] = 'bee@example.com'
+            self.assertEqual(other.header_log, {
+                'subject': ['hello'], 'to': ['ant@example.com']})
+
+    def test_stop_header_log(self):
+        msg = self._msg()
+        del msg['subject']
+        msg.stop_header_log()
+        self.assertIsNone(msg.header_log)
+        msg['To'] = 'bee@example.com'
+        self.assertIsNone(msg.header_log)
+
+    def test_unpickle_without_log(self):
+        # A message pickled before the log existed.
+        msg = mfs(self.RAW)
+        state = pickle.dumps(msg)
+        self.assertIsNone(pickle.loads(state).header_log)
+
+    def testprepend_header(self):
+        msg = self._msg()
+        msg.prepend_header('Message-Instance', 'm=1; h=x; b=y;')
+        self.assertEqual(msg.header_log, {})
+        self.assertEqual(msg.keys()[0], 'Message-Instance')
