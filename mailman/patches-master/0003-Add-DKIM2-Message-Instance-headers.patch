+        message_instance: yes
+        """.format(template_dir))
+        self.addCleanup(config.pop, 'test_mi')
+        site_dir = os.path.join(config.TEMPLATE_DIR, 'site', 'en')
+        os.makedirs(site_dir)
+        footer_path = os.path.join(site_dir, 'myfooter.txt')
