@@ -0,0 +1,297 @@
+# Copyright (C) 2026 by the Free Software Foundation, Inc.
+#
+# This file is part of GNU Mailman.
+#
+# GNU Mailman is free software: you can redistribute it and/or modify it under
+# the terms of the GNU General Public License as published by the Free
+# Software Foundation, either version 3 of the License, or (at your option)
+# any later version.
+
+"""Regression: the egress Message-Instance recipe must reverse cleanly.
+
+A list post is hashed at ingress (m=1), modified by Mailman (subject prefix,
+list headers, footer), and an egress recipe (m=2) is recorded. A verifier
+reconstructs the original by undoing m=2 and re-hashing — that reconstruction
+MUST match the m=1 header/body hash, or downstream full-chain verification
+fails. These are pure-function tests (no config/database layer needed).
+"""
+
+import os
+import email
+import unittest
+
+from mailman.app.lifecycle import create_list
+from mailman.config import config
+from mailman.core.pipelines import process as process_pipeline
+from mailman.email.message import Message
+from mailman.handlers.message_instance import (
+    _b64,
+    _collect_headers,
+    _parse_mi,
+    _wire_bytes,
+    arrival_record,
+    build_mi_header_value,
+    compute_header_hash,
+    compute_header_recipe,
+    get_max_mi_version,
+)
+from mailman.handlers.tests.mi_support import (
+    _get_body_lines,
+    compute_body_hash,
+    undo_message_instance,
+    verify_message_instance,
+)
+from mailman.interfaces.mailinglist import (
+    DMARCMitigateAction,
+    Personalization,
+    ReplyToMunging,
+)
+from mailman.interfaces.template import ITemplateManager
+from mailman.mta.deliver import Deliver
+from mailman.testing.helpers import get_queue_messages, subscribe
+from mailman.testing.layers import ConfigLayer
+from mailman.utilities.email import add_message_hash
+from tempfile import TemporaryDirectory
+from zope.component import getUtility
+
+
+ORIGINAL = (
+    'From: Bron <brong@example.com>\r\n'
+    'To: test@lists.example.com\r\n'
+    'Subject: hello there\r\n'
+    'Message-ID: <orig-1@example.com>\r\n'
+    'Date: Wed, 24 Jun 2026 20:00:00 +0000\r\n'
+    'MIME-Version: 1.0\r\n'
+    'Content-Type: text/plain; charset="utf-8"\r\n'
+    'Content-Transfer-Encoding: 7bit\r\n'
+    '\r\n'
+    'Original body line one.\r\n'
+    'Original body line two.\r\n'
+)
+
+
+def _make_original():
+    return email.message_from_string(ORIGINAL)
+
+
+def _round_trip(modify):
+    """Apply `modify` to a fresh original, build the egress recipe, undo it,
+    and return (ok, detail) for whether the reconstruction matches m=1."""
+    orig = _make_original()
+    h1 = compute_header_hash(orig)
+    b1 = compute_body_hash(orig)
+    prev_headers = _collect_headers(orig)
+    prev_body = _get_body_lines(orig)
+
+    mod = email.message_from_bytes(orig.as_bytes())
+    modify(mod)
+
+    header_recipe = compute_header_recipe(_collect_headers(mod), prev_headers)
+    # The previous body as literals: these tests are about the headers.
+    body_recipe = (None if _get_body_lines(mod) == prev_body
+                   else [{'d': prev_body}])
+    mi2 = build_mi_header_value(2, compute_header_hash(mod),
+                                compute_body_hash(mod), header_recipe,
+                                body_recipe)
+    mi1 = build_mi_header_value(1, h1, b1)
+    # Prepend m=1 then m=2 (highest first), as on the wire.
+    mod._headers.insert(0, ('Message-Instance', mi1))
+    mod._headers.insert(0, ('Message-Instance', mi2))
+
+    undo_message_instance(mod)
+    got_h = _b64(compute_header_hash(mod))
+    got_b = _b64(compute_body_hash(mod))
+    detail = []
+    if got_h != _b64(h1):
+        detail.append('header hash {} != {}'.format(got_h, _b64(h1)))
+    if got_b != _b64(b1):
+        detail.append('body hash {} != {}'.format(got_b, _b64(b1)))
+    return (not detail), '; '.join(detail)
+
+
+class TestMIRoundTrip(unittest.TestCase):
+    def test_subject_prefix_only(self):
+        def m(msg):
+            msg.replace_header('Subject', '[Test] hello there')
+        ok, detail = _round_trip(m)
+        self.assertTrue(ok, detail)
+
+    def test_added_list_headers(self):
+        def m(msg):
+            msg['List-Id'] = 'Test <test.lists.example.com>'
+            msg['List-Post'] = '<mailto:test@lists.example.com>'
+            msg['Archived-At'] = '<https://archive.example.com/x>'
+            msg['Precedence'] = 'list'
+        ok, detail = _round_trip(m)
+        self.assertTrue(ok, detail)
+
+    def test_footer_appended(self):
+        def m(msg):
+            body = msg.get_payload()
+            msg.set_payload(body + '-- \r\nMailing list footer\r\n')
+        ok, detail = _round_trip(m)
+        self.assertTrue(ok, detail)
+
+    def test_minimal_original_mailman_adds_mime_headers(self):
+        # The real-world list case: the author sends a bare message with NO
+        # Content-Type/MIME-Version/Content-Transfer-Encoding, and Mailman adds
+        # them (plus list headers + subject prefix + footer). Undo must remove
+        # the mailman-added headers so the reconstruction matches the bare m=1.
+        global ORIGINAL
+        saved = ORIGINAL
+        try:
+            ORIGINAL = (
+                'From: Bron <brong@example.com>\r\n'
+                'To: test@lists.example.com\r\n'
+                'Subject: hello there\r\n'
+                'Message-ID: <orig-1@example.com>\r\n'
+                'Date: Wed, 24 Jun 2026 20:00:00 +0000\r\n'
+                '\r\n'
+                'Capture body.\r\n'
+            )
+
+            def m(msg):
+                msg.replace_header('Subject', '[Test] hello there')
+                msg['MIME-Version'] = '1.0'
+                msg['Content-Type'] = 'text/plain; charset="utf-8"'
+                msg['Content-Transfer-Encoding'] = '7bit'
+                msg['List-Id'] = 'Test <test.lists.example.com>'
+                msg['Archived-At'] = '<https://archive.example.com/x>'
+                msg['Precedence'] = 'list'
+                body = msg.get_payload()
+                msg.set_payload(body + '-- \r\nfooter\r\n')
+            ok, detail = _round_trip(m)
+            self.assertTrue(ok, detail)
+        finally:
+            ORIGINAL = saved
+
+    def test_full_list_transformation(self):
+        # Everything a list does at once: the real-world case.
+        def m(msg):
+            msg.replace_header('Subject', '[Test] hello there')
+            msg['List-Id'] = 'Test <test.lists.example.com>'
+            msg['List-Post'] = '<mailto:test@lists.example.com>'
+            msg['Archived-At'] = '<https://archive.example.com/x>'
+            msg['Precedence'] = 'list'
+            body = msg.get_payload()
+            msg.set_payload(body + '-- \r\nMailing list footer\r\n')
+        ok, detail = _round_trip(m)
+        self.assertTrue(ok, detail)
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
+
+
+class _CapturingDeliver(Deliver):
+    """Deliver, keeping each copy instead of sending it."""
+
+    def __init__(self):
+        super().__init__()
+        self.copies = []
+
+    def _deliver_to_recipients(self, mlist, msg, msgdata, recipients):
+        self.copies.append((msg, msgdata))
+        return []
+
+
+class TestEveryHeaderFeature(unittest.TestCase):
+    """A post through the whole posting pipeline and personalised delivery
+    on a list using every feature that changes header fields: every copy's
+    Message-Instance must undo to the post as received.  A header change
+    the log missed would show up here as a copy with no instance or one
+    whose Recipe does not rebuild the arrival digests."""
+
+    layer = ConfigLayer
+
+    RAW = (b'From: Carl <carl@example.com>\r\n'
+           b'To: ant@example.com\r\n'
+           b'Cc: bart@example.com, someone@example.net\r\n'
+           b'Subject: every feature\r\n'
+           b'Message-ID: <every@example.com>\r\n'
+           b'Date: Fri, 13 Nov 2026 12:00:00 +0000\r\n'
+           b'Return-Receipt-To: carl@example.com\r\n'
+           b'Disposition-Notification-To: carl@example.com\r\n'
+           b'MIME-Version: 1.0\r\n'
+           b'Content-Type: text/plain; charset="utf-8"\r\n'
+           b'Content-Transfer-Encoding: 8bit\r\n'
+           b'\r\n'
+           b'Caf\xc3\xa9.\r\n'
+           b'From the list\r\n')
+
+    def setUp(self):
+        self._mlist = create_list('ant@example.com')
+        self._mlist.preferred_language = 'en'
+        self._mlist.subject_prefix = '[Ant] '
+        self._mlist.reply_goes_to_list = ReplyToMunging.explicit_header
+        self._mlist.reply_to_address = 'discuss@example.com'
+        self._mlist.first_strip_reply_to = True
+        self._mlist.dmarc_mitigate_action = DMARCMitigateAction.munge_from
+        self._mlist.dmarc_mitigate_unconditionally = True
+        self._mlist.personalize = Personalization.full
+        subscribe(self._mlist, 'Anne', email='anne@example.com')
+        subscribe(self._mlist, 'Bart', email='bart@example.com')
+        temporary_dir = TemporaryDirectory()
+        self.addCleanup(temporary_dir.cleanup)
+        config.push('every_feature', """\
+        [paths.testing]
+        template_dir: {}
+        [mta]
+        message_instance: yes
+        """.format(temporary_dir.name))
+        self.addCleanup(config.pop, 'every_feature')
+        site_dir = os.path.join(config.TEMPLATE_DIR, 'site', 'en')
+        os.makedirs(site_dir)
+        for name, text in (('h.txt', 'Header for $user_address'),
+                           ('f.txt', 'Footer for $user_address')):
+            with open(os.path.join(site_dir, name), 'w',
+                      encoding='utf-8') as fp:
+                print(text, file=fp)
+        manager = getUtility(ITemplateManager)
+        manager.set('list:member:regular:header', None, 'mailman:///h.txt')
+        manager.set('list:member:regular:footer', None, 'mailman:///f.txt')
+
+    def test_every_copy_undoes_to_the_post(self):
+        self._check(self.RAW, version=1)
+
+    def test_signed_post(self):
+        mi1 = build_mi_header_value(
+            1, arrival_record(self.RAW)['header_hash'],
+            arrival_record(self.RAW)['body_hash'])
+        raw = (b'DKIM2-Signature: i=1; m=1; d=example.com\r\n'
+               b'Message-Instance: ' + mi1.encode() + b'\r\n' + self.RAW)
+        self._check(raw, version=2)
+
+    def _check(self, raw, version):
+        msg = email.message_from_bytes(raw, Message)
+        msg.mi_arrival = arrival_record(raw)
+        msg.start_header_log()
+        add_message_hash(msg)
+        process_pipeline(self._mlist, msg, {}, 'default-posting-pipeline')
+        item = get_queue_messages('out', expected_count=1)[0]
+        agent = _CapturingDeliver()
+        agent.deliver(self._mlist, item.msg, item.msgdata)
+        self.assertEqual(len(agent.copies), 2)
+        for copy_msg, _ in agent.copies:
+            # As the recipient gets it.
+            wire = email.message_from_bytes(_wire_bytes(copy_msg), Message)
+            with self.subTest(to=str(copy_msg['To'])):
+                self.assertTrue(str(wire['Subject']).startswith('[Ant]'))
+                recipe = [_parse_mi(v)[2]
+                          for v in wire.get_all('message-instance')
+                          if 'm={};'.format(version) in v][0]
+                # The body comes back from the wrap, From line and all.
+                self.assertEqual(_data_steps(recipe['b']),
+                                 [{'d': ['From the list']}])
+                self.assertEqual(get_max_mi_version(wire), version)
+                self.assertEqual(verify_message_instance(wire),
+                                 (version, None))
+                self.assertEqual(undo_message_instance(wire), version)
+                self.assertEqual(compute_header_hash(wire),
+                                 msg.mi_arrival['header_hash'])
+                self.assertEqual(compute_body_hash(wire),
+                                 msg.mi_arrival['body_hash'])
+
+
+def _data_steps(steps):
+    return [s for s in steps if 'd' in s]
