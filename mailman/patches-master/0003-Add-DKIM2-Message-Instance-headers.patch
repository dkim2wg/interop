+class TestHeaderWireForm(unittest.TestCase):
+    """The header hash and Recipe see the headers as they go on the wire."""
+
+    layer = ConfigLayer
+
+    def setUp(self):
+        self._mlist = create_list('ant@example.com')
+        self._mlist.preferred_language = 'en'
