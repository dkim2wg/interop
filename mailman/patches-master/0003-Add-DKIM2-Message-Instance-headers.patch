+        self._ingress.process(self._mlist, msg, msgdata)
+        self._egress.process(self._mlist, msg, msgdata)
+        steps = _recipe_at(msg, 1)['b']
+        self.assertEqual(steps, [{'c': [1, 1]}, {'d': ['From here']}])
