+class TestMessageInstanceFlow(unittest.TestCase):
+    """Test MI ingress → modification → egress → undo → verify."""
+
+    layer = ConfigLayer
+
+    def setUp(self):
+        self._mlist = create_list('ant@example.com')
+        self._mlist.preferred_language = 'en'
